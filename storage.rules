rules_version = '2';
// Deploy: firebase deploy --only storage --project elrace-new
// Project: elrace-new
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function chatPath(chatId) {
      return /databases/(default)/documents/chats/$(chatId);
    }

    function memberDocPath(chatId) {
      return /databases/(default)/documents/chats/$(chatId)/members/$(request.auth.uid);
    }

    function messagePath(chatId, messageId) {
      return /databases/(default)/documents/chats/$(chatId)/messages/$(messageId);
    }

    function chatData(chatId) {
      return firestore.get(chatPath(chatId)).data;
    }

    // Align with Firestore membership: member_ids, members/{uid}, or dm_pair.
    // Hub/mobile sometimes have members/{uid} before member_ids is fully synced.
    function isChatMember(chatId) {
      return isSignedIn()
        && firestore.exists(chatPath(chatId))
        && (
          (
            chatData(chatId).keys().hasAny(['member_ids'])
            && chatData(chatId).member_ids is list
            && request.auth.uid in chatData(chatId).member_ids
          )
          || firestore.exists(memberDocPath(chatId))
          || (
            chatData(chatId).keys().hasAny(['dm_pair'])
            && chatData(chatId).dm_pair is list
            && request.auth.uid in chatData(chatId).dm_pair
          )
        );
    }

    function validChatMediaWrite() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf|audio/.*|video/.*|application/octet-stream'
        );
    }

    // Sender may delete Storage object tied to their message (delete-for-everyone).
    function canDeleteOwnMessageMedia(chatId, messageId) {
      return isChatMember(chatId)
        && firestore.exists(messagePath(chatId, messageId))
        && firestore.get(messagePath(chatId, messageId)).data.sender_id
          == request.auth.uid;
    }

    // Canonical chat media path only: chat_media/{chatId}/{messageId}/{fileName}
    match /chat_media/{chatId}/{messageId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow create, update: if isChatMember(chatId) && validChatMediaWrite();
      allow delete: if canDeleteOwnMessageMedia(chatId, messageId);
    }

    // My Notes audio / images — owner only
    match /users/{userId}/notes/{noteId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*|image/.*|application/octet-stream');
    }

    // Deny malformed chat_media paths and everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
