rules_version = '2';
// Deploy: firebase deploy --only storage --project elrace-new
// Project: elrace-new
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return firestore.exists(/databases/(default)/documents/chats/$(chatId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.member_ids;
    }

    function validChatMediaWrite() {
      return request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|application/pdf|audio/.*|video/.*|application/octet-stream'
        );
    }

    // Canonical chat media path only: chat_media/{chatId}/{messageId}/{fileName}
    match /chat_media/{chatId}/{messageId}/{fileName} {
      allow read: if isSignedIn() && isChatMember(chatId);
      allow write: if isSignedIn()
                   && isChatMember(chatId)
                   && validChatMediaWrite();
    }

    // My Notes audio / images — owner only
    match /users/{userId}/notes/{noteId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*|image/.*|application/octet-stream');
    }

    // Deny malformed chat_media paths and everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
