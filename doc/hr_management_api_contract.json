      { "label": "Reason", "value": "..." }
    ],
    "timeline": [
      { "title": "Submitted", "subtitle": "12 May 2026", "state": "COMPLETED" },
      { "title": "To Approve (Manager)", "subtitle": null, "state": "CURRENT" }
    ],
    "attachments": [],
    "comments": [],
