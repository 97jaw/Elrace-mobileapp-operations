{
  "name": "el-race-cloud-functions",
  "description": "Cloud Functions for El Race App chat notifications",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync:chat-users": "node scripts/sync_odoo_chat_users.js --dry-run",
    "sync:chat-users:firestore-audit": "node scripts/sync_odoo_chat_users.js --firestore-audit-only",
    "sync:chat-users:apply": "node scripts/sync_odoo_chat_users.js --apply",
    "sync:chat-users:apply-heal": "node scripts/sync_odoo_chat_users.js --apply --heal-dm-titles"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1053.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "openai": "^4.104.0"
  },
  "private": true
}
