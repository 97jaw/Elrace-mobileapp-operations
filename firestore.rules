rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTodoStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'assigned_members',
        'followed_up_by',
        'is_completed',
        'is_important',
        'is_my_day',
        'sort_order',
        'updated_at'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /fcm_tokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /todos/{todoId} {
        allow read: if isSignedIn();
        // Allow create by owner OR by any signed-in user (for task assignment)
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() &&
            (request.auth.uid == userId || isTodoStatusOnlyUpdate());

        match /comments/{commentId} {
          allow read, write: if isSignedIn();
        }
      }

      match /tickets/{ticketId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /todoLists/{listId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // Signature -> Documents tab personal library (self-signed + sent-for-signature copies).
      // Owner full access. Current recipient may sync status after signing
      // (chat client updates users/{owner}/signature_documents/{id}).
      match /signature_documents/{docId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource != null &&
           resource.data.recipient_uid == request.auth.uid)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource.data.recipient_uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'signed_pdf_url',
                'file_url',
                'signed_at',
                'signed_by',
                'recipient_uid',
                'recipient_name',
                'current_signer_index',
                'updated_at'
              ])
          )
        );
      }

      // My Notes — personal notes (text / audio / image).
      // Owner full access; sharedWithUids get view-only read.
      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource.data.sharedWithUids != null &&
           request.auth.uid in resource.data.sharedWithUids)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
      }

      // Inbox pointers for notes shared with this user (view-only listing).
      match /shared_note_refs/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow create: if isSignedIn();
      // Read: members, open role chats, or legacy docs without member_ids.
      allow read: if isSignedIn() &&
                     (resource.data.type == 'role' ||
                      resource.data.member_ids == null ||
                      request.auth.uid in resource.data.member_ids ||
                      (resource.data.dm_pair != null &&
                       request.auth.uid in resource.data.dm_pair));
      // Update: must already be a member, be in dm_pair, or be joining a role chat.
      // Note: security checks use pre-write `resource.data`, so arrayUnion alone
      // cannot self-authorize an update for a brand-new member on an existing doc.
      allow update: if isSignedIn() &&
                       (resource.data.member_ids == null ||
                        request.auth.uid in resource.data.member_ids ||
                        (resource.data.dm_pair != null &&
                         request.auth.uid in resource.data.dm_pair) ||
                        (resource.data.type == 'role' &&
                         request.auth.uid in request.resource.data.member_ids));
      allow delete: if false;

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }

      match /members/{memberId} {
        allow read, write: if isSignedIn();
      }
    }

    // userChats: owner has full read + delete access.
    // Any authenticated user can create/update entries (needed for DM:
    // sender creates recipient's chat list entry so the chat shows for them).
    match /userChats/{userId}/{document=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ── collectionGroup('todos') support ──
    // Allows any signed-in user to READ todos across all user paths.
    // Required for assigned-task queries via collectionGroup.
    match /{path=**}/todos/{todoId} {
      allow read: if isSignedIn();
    }

    // Assignment FCM queue — clients enqueue, Cloud Functions deliver.
    match /assignment_push_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    // Ticket creator lookup for completion FCM (Odoo tickets).
    match /ticket_creators/{taskId} {
      allow create, update: if isSignedIn();
      allow read: if isSignedIn();
      allow delete: if false;
    }
  }
}
