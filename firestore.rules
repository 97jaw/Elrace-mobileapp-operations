rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatExists(chatId) {
      return exists(chatPath(chatId));
    }

    function chatData(chatId) {
      return get(chatPath(chatId)).data;
    }

    function isMemberOfChat(chatId) {
      return chatExists(chatId)
        && chatData(chatId).member_ids is list
        && uid() in chatData(chatId).member_ids;
    }

    function isMemberFromChatResource() {
      return resource.data.member_ids is list
        && uid() in resource.data.member_ids;
    }

    function isInDmPairFromResource() {
      return resource.data.dm_pair is list
        && uid() in resource.data.dm_pair;
    }

    function validChatType(data) {
      return data.type in ['dm', 'role', 'group', 'support'];
    }

    function validChatIdForType(chatId, data) {
      return (data.type == 'dm' && chatId.matches('dm_.+'))
        || (data.type == 'role' && chatId.matches('role_.+'))
        || (data.type == 'support' && chatId.matches('support_.+'))
        || (data.type == 'group' && chatId.matches('project_.+'));
    }

    function selfInMemberIds(data) {
      return data.member_ids is list && uid() in data.member_ids;
    }

    function validDmCreate(chatId, data) {
      return data.type == 'dm'
        && data.dm_pair is list
        && data.dm_pair.size() >= 1
        && data.dm_pair.size() <= 2
        && uid() in data.dm_pair
        && selfInMemberIds(data)
        && (
          chatId.matches('dm_' + uid() + '_.*')
          || chatId.matches('dm_.*_' + uid())
        );
    }

    function validRoleOrGroupOrSupportCreate(data) {
      return data.type in ['role', 'group', 'support']
        && selfInMemberIds(data);
    }

    function canCreateChat(chatId) {
      return isSignedIn()
        && validChatType(request.resource.data)
        && validChatIdForType(chatId, request.resource.data)
        && (
          validDmCreate(chatId, request.resource.data)
          || validRoleOrGroupOrSupportCreate(request.resource.data)
        );
    }

    function canReadChat() {
      return isSignedIn() && (
        isMemberFromChatResource()
        || isInDmPairFromResource()
      );
    }

    // Role join: existing members, dm pair, or joining a role chat as self.
    function canUpdateChat() {
      return isSignedIn() && (
        isMemberFromChatResource()
        || isInDmPairFromResource()
        || (
          resource.data.type == 'role'
          && request.resource.data.type == 'role'
          && selfInMemberIds(request.resource.data)
        )
      );
    }

    function isDmChatIdWithSelf(chatId) {
      return chatId.matches('dm_.+')
        && (
          chatId.matches('dm_' + uid() + '_.*')
          || chatId.matches('dm_.*_' + uid())
        );
    }

    function canWriteMemberDoc(chatId, memberId) {
      return isSignedIn() && (
        (
          memberId == uid()
          && (
            isMemberOfChat(chatId)
            || (
              chatExists(chatId)
              && chatData(chatId).type in ['role', 'group', 'support']
            )
            || isDmChatIdWithSelf(chatId)
            || chatId.matches('role_.+')
            || chatId.matches('support_.+')
            || chatId.matches('project_.+')
          )
          && (
            !('is_admin' in request.resource.data)
            || request.resource.data.is_admin == false
            || isMemberOfChat(chatId)
          )
        )
        || (
          memberId != uid()
          && isMemberOfChat(chatId)
          && (
            !('is_admin' in request.resource.data)
            || request.resource.data.is_admin == false
          )
        )
        || (
          memberId != uid()
          && isDmChatIdWithSelf(chatId)
          && (
            !('is_admin' in request.resource.data)
            || request.resource.data.is_admin == false
          )
        )
      );
    }

    function canDeleteMemberDoc(chatId, memberId) {
      return isSignedIn() && (
        memberId == uid()
        || isMemberOfChat(chatId)
      );
    }

    function senderUnchanged() {
      return request.resource.data.sender_id == resource.data.sender_id;
    }

    function isMessageCreateValid() {
      return request.resource.data.sender_id == uid()
        && request.resource.data.keys().hasAll(['sender_id', 'type', 'created_at']);
    }

    // Signing transitions: only current signer (or listed signer) may touch sign fields.
    function signingKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'sign_status',
          'signed_pdf_url',
          'signed_at',
          'signed_by',
          'current_signer_index',
          'current_signer_uid',
          'media_url',
          'status',
          'updated_at'
        ]);
    }

    function touchesSigningFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'sign_status',
          'signed_pdf_url',
          'signed_at',
          'signed_by',
          'current_signer_index',
          'current_signer_uid'
        ]);
    }

    function isAuthorizedSignerUpdate() {
      return signingKeysOnly()
        && (
          resource.data.current_signer_uid == uid()
          || (
            resource.data.keys().hasAny(['signer_uids'])
            && resource.data.signer_uids is list
            && uid() in resource.data.signer_uids
          )
        )
        && (
          !('signed_by' in request.resource.data)
          || request.resource.data.signed_by == uid()
        );
    }

    function isOwnMessageNonSenderEdit() {
      return resource.data.sender_id == uid()
        && senderUnchanged()
        && !touchesSigningFields();
    }

    function canUpdateMessage(chatId) {
      return isMemberOfChat(chatId)
        && senderUnchanged()
        && (
          isAuthorizedSignerUpdate()
          || isOwnMessageNonSenderEdit()
        );
    }

    function isTodoStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'assigned_members',
        'followed_up_by',
        'is_completed',
        'is_important',
        'is_my_day',
        'sort_order',
        'updated_at'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /fcm_tokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /todos/{todoId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() &&
            (request.auth.uid == userId || isTodoStatusOnlyUpdate());

        match /comments/{commentId} {
          allow read, write: if isSignedIn();
        }
      }

      match /tickets/{ticketId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /todoLists/{listId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /signature_documents/{docId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource != null &&
           resource.data.recipient_uid == request.auth.uid)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource.data.recipient_uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'signed_pdf_url',
                'file_url',
                'signed_at',
                'signed_by',
                'recipient_uid',
                'recipient_name',
                'current_signer_index',
                'updated_at'
              ])
          )
        );
      }

      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource.data.sharedWithUids != null &&
           request.auth.uid in resource.data.sharedWithUids)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
      }

      match /shared_note_refs/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow create: if canCreateChat(chatId);
      allow read: if canReadChat();
      allow update: if canUpdateChat();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && isMemberOfChat(chatId);
        allow create: if isSignedIn()
          && isMemberOfChat(chatId)
          && isMessageCreateValid();
        allow update: if isSignedIn() && canUpdateMessage(chatId);
        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && isMemberOfChat(chatId);
        allow create, update: if canWriteMemberDoc(chatId, memberId);
        allow delete: if canDeleteMemberDoc(chatId, memberId);
      }
    }

    // Inbox index — owner full access; other chat members may sync timestamps.
    match /userChats/{userId}/chats/{chatId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn() && (
        uid() == userId
        || isMemberOfChat(chatId)
      );
      allow delete: if isSignedIn() && uid() == userId;
    }

    match /userChats/{userId}/starred_messages/{messageId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // Legacy Firestore presence (unused by chat — RTDB is authoritative).
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{path=**}/todos/{todoId} {
      allow read: if isSignedIn();
    }

    match /assignment_push_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /ticket_creators/{taskId} {
      allow create, update: if isSignedIn();
      allow read: if isSignedIn();
      allow delete: if false;
    }
  }
}
