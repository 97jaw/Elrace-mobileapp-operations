rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function chatPath(chatId) {
      return /databases/$(database)/documents/chats/$(chatId);
    }

    function chatExists(chatId) {
      return exists(chatPath(chatId));
    }

    function chatData(chatId) {
      return get(chatPath(chatId)).data;
    }

    function memberPath(chatId, memberId) {
      return /databases/$(database)/documents/chats/$(chatId)/members/$(memberId);
    }

    function isMemberOfChat(chatId) {
      return chatExists(chatId)
        && chatData(chatId).member_ids is list
        && uid() in chatData(chatId).member_ids;
    }

    function isMemberFromChatResource() {
      return resource.data.member_ids is list
        && uid() in resource.data.member_ids;
    }

    function isInDmPairFromResource() {
      return resource.data.dm_pair is list
        && uid() in resource.data.dm_pair;
    }

    function isChatAdmin(chatId) {
      return exists(memberPath(chatId, uid()))
        && get(memberPath(chatId, uid())).data.is_admin == true;
    }

    function validChatType(data) {
      return data.type in ['dm', 'role', 'group', 'support'];
    }

    function validMessageType(t) {
      return t in ['text', 'image', 'file', 'audio', 'video', 'signable_doc'];
    }

    function authRoleId() {
      return request.auth.token.role_id;
    }

    function authBranchId() {
      return request.auth.token.branch_id;
    }

    function roleClaimMatchesChat(data) {
      return authRoleId() != null
        && data.role_id != null
        && authRoleId() == data.role_id
        && (
          !('branch_id' in data)
          || data.branch_id == null
          || authBranchId() == data.branch_id
        );
    }

    // Deterministic DM id: dm_{minUid}_{maxUid} with sorted dm_pair.
    function validDeterministicDmCreate(chatId, data) {
      return data.type == 'dm'
        && data.dm_pair is list
        && data.dm_pair.size() == 2
        && data.dm_pair[0] is string
        && data.dm_pair[1] is string
        && data.dm_pair[0] <= data.dm_pair[1]
        && chatId == 'dm_' + data.dm_pair[0] + '_' + data.dm_pair[1]
        && uid() in data.dm_pair
        && data.member_ids is list
        && uid() in data.member_ids
        && data.member_ids.hasOnly(data.dm_pair);
    }

    function validRoleCreate(chatId, data) {
      return data.type == 'role'
        && chatId.matches('role_.+')
        && data.member_ids is list
        && uid() in data.member_ids
        && roleClaimMatchesChat(data);
    }

    function validGroupCreate(chatId, data) {
      return data.type == 'group'
        && chatId.matches('project_.+')
        && data.member_ids is list
        && uid() in data.member_ids;
    }

    function validSupportCreate(chatId, data) {
      return data.type == 'support'
        && chatId.matches('support_.+')
        && data.member_ids is list
        && uid() in data.member_ids
        && data.support_user_uid is string
        && (
          uid() == data.support_user_uid
          || roleClaimMatchesChat(data)
        );
    }

    function canCreateChat(chatId) {
      return isSignedIn()
        && validChatType(request.resource.data)
        && (
          validDeterministicDmCreate(chatId, request.resource.data)
          || validRoleCreate(chatId, request.resource.data)
          || validGroupCreate(chatId, request.resource.data)
          || validSupportCreate(chatId, request.resource.data)
        );
    }

    function canReadChat() {
      return isSignedIn() && (
        isMemberFromChatResource()
        || isInDmPairFromResource()
      );
    }

    // type / member_ids / dm_pair are immutable after create, except proven
    // role self-add (token role matches) or group admin membership edits.
    function chatCoreImmutable() {
      return request.resource.data.type == resource.data.type
        && (
          !('dm_pair' in resource.data)
          || request.resource.data.dm_pair == resource.data.dm_pair
        );
    }

    function memberIdsUnchanged() {
      return request.resource.data.member_ids == resource.data.member_ids;
    }

    function onlyAddedSelfToMemberIds() {
      return resource.data.member_ids is list
        && request.resource.data.member_ids is list
        && !(uid() in resource.data.member_ids)
        && uid() in request.resource.data.member_ids
        && request.resource.data.member_ids.hasAll(resource.data.member_ids)
        && request.resource.data.member_ids.size()
          == resource.data.member_ids.size() + 1;
    }

    function provenRoleSelfJoinUpdate() {
      return resource.data.type == 'role'
        && chatCoreImmutable()
        && onlyAddedSelfToMemberIds()
        && roleClaimMatchesChat(resource.data);
    }

    function groupAdminMemberIdsUpdate(chatId) {
      return resource.data.type == 'group'
        && chatCoreImmutable()
        && isChatAdmin(chatId)
        && request.resource.data.member_ids is list;
    }

    function canUpdateChat(chatId) {
      return isSignedIn()
        && chatCoreImmutable()
        && (
          (isMemberFromChatResource() && memberIdsUnchanged())
          || (isInDmPairFromResource() && memberIdsUnchanged())
          || provenRoleSelfJoinUpdate()
          || groupAdminMemberIdsUpdate(chatId)
        );
    }

    function isDmPeerOfChat(chatId) {
      return chatExists(chatId)
        && chatData(chatId).type == 'dm'
        && chatData(chatId).dm_pair is list
        && uid() in chatData(chatId).dm_pair;
    }

    function targetIsDmPeer(chatId, memberId) {
      return chatExists(chatId)
        && chatData(chatId).type == 'dm'
        && chatData(chatId).dm_pair is list
        && memberId in chatData(chatId).dm_pair;
    }

    function notElevatingAdmin() {
      return !('is_admin' in request.resource.data)
        || request.resource.data.is_admin == false
        || (
          resource != null
          && resource.data.is_admin == true
        );
    }

    function canWriteOwnMemberDoc(chatId) {
      return isMemberOfChat(chatId)
        || isDmPeerOfChat(chatId)
        || (
          chatExists(chatId)
          && chatData(chatId).type == 'role'
          && roleClaimMatchesChat(chatData(chatId))
        )
        || (
          chatExists(chatId)
          && chatData(chatId).type == 'support'
          && (
            uid() == chatData(chatId).support_user_uid
            || roleClaimMatchesChat(chatData(chatId))
            || isMemberOfChat(chatId)
          )
        )
        || (
          chatExists(chatId)
          && chatData(chatId).type == 'group'
          && isMemberOfChat(chatId)
        );
    }

    function canWriteMemberDoc(chatId, memberId) {
      return isSignedIn()
        && notElevatingAdmin()
        && receiptFieldsNotForged(memberId)
        && (
        (memberId == uid() && canWriteOwnMemberDoc(chatId))
        || (
          memberId != uid()
          && isDmPeerOfChat(chatId)
          && targetIsDmPeer(chatId, memberId)
        )
        || (
          memberId != uid()
          && chatExists(chatId)
          && chatData(chatId).type == 'group'
          && isChatAdmin(chatId)
        )
      );
    }

    // Only the member themselves may set receipt watermarks, and only as
    // server timestamps (FieldValue.serverTimestamp() == request.time).
    function receiptFieldsNotForged(memberId) {
      let data = request.resource.data;
      let changingReceipts = resource == null
        ? data.keys().hasAny(['last_read_at', 'last_delivered_at'])
        : request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['last_read_at', 'last_delivered_at']);

      return !changingReceipts || (
        memberId == uid()
        && (
          !('last_read_at' in data)
          || data.last_read_at == request.time
        )
        && (
          !('last_delivered_at' in data)
          || data.last_delivered_at == request.time
        )
      );
    }

    function canDeleteMemberDoc(chatId, memberId) {
      return isSignedIn() && (
        memberId == uid()
        || (
          chatExists(chatId)
          && chatData(chatId).type == 'group'
          && isChatAdmin(chatId)
        )
      );
    }

    function messageCreateKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        'sender_id',
        'type',
        'text',
        'created_at',
        'client_msg_id',
        'status',
        'media_url',
        'media_path',
        'file_name',
        'file_size',
        'mime_type',
        'duration_ms',
        'thumb_url',
        'reply_to',
        'sign_zones',
        'sign_status',
        'signed_pdf_url',
        'signed_at',
        'signed_by',
        'signer_uids',
        'signer_names',
        'current_signer_index',
        'current_signer_uid',
        'expires_at',
        'signature_document_id',
        'updated_at'
      ]);
    }

    function createdAtIsFresh() {
      return request.resource.data.created_at is timestamp
        && request.resource.data.created_at
          <= request.time + duration.value(1, 'm')
        && request.resource.data.created_at
          >= request.time - duration.value(5, 'm');
    }

    function isMessageCreateValid() {
      return request.resource.data.sender_id == uid()
        && request.resource.data.keys().hasAll(['sender_id', 'type', 'created_at'])
        && validMessageType(request.resource.data.type)
        && messageCreateKeysAllowed()
        && createdAtIsFresh();
    }

    function messageImmutableFieldsUnchanged() {
      return request.resource.data.sender_id == resource.data.sender_id
        && request.resource.data.type == resource.data.type
        && request.resource.data.created_at == resource.data.created_at
        && (
          !('client_msg_id' in resource.data)
          || !('client_msg_id' in request.resource.data)
          || request.resource.data.client_msg_id == resource.data.client_msg_id
        );
    }

    function signingKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'sign_status',
          'signed_pdf_url',
          'signed_at',
          'signed_by',
          'current_signer_index',
          'current_signer_uid',
          'media_url',
          'status',
          'updated_at'
        ]);
    }

    function touchesSigningFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'sign_status',
          'signed_pdf_url',
          'signed_at',
          'signed_by',
          'current_signer_index',
          'current_signer_uid'
        ]);
    }

    function validSignStatusTransition() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['sign_status'])
        || (
          resource.data.sign_status == 'pending'
          && request.resource.data.sign_status in ['pending', 'signed']
        );
    }

    function isAuthorizedSignerUpdate() {
      return signingKeysOnly()
        && validSignStatusTransition()
        && resource.data.current_signer_uid == uid()
        && (
          !('signed_by' in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data.signed_by == uid()
        );
    }

    function isOwnMessageNonSenderEdit() {
      return resource.data.sender_id == uid()
        && !touchesSigningFields()
        && (
          !('status' in request.resource.data)
          || request.resource.data.status != 'deleted'
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['text', 'status', 'updated_at', 'media_url', 'media_path']);
    }

    // Soft-delete for everyone: sender only, within 10 minutes of created_at.
    // Clears body/media so clients render “This message was deleted”.
    function isSoftDeleteUpdate() {
      return resource.data.sender_id == uid()
        && resource.data.created_at is timestamp
        && request.time <= resource.data.created_at + duration.value(10, 'm')
        && (
          !('status' in resource.data)
          || resource.data.status != 'deleted'
        )
        && request.resource.data.status == 'deleted'
        && !touchesSigningFields()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'text',
            'media_url',
            'media_path',
            'thumb_url',
            'file_name',
            'file_size',
            'mime_type',
            'duration_ms',
            'updated_at',
            'deleted_at'
          ])
        && (
          !('text' in request.resource.data)
          || request.resource.data.text == null
          || request.resource.data.text == ''
        )
        && (
          !('media_url' in request.resource.data)
          || request.resource.data.media_url == null
        )
        && (
          !('media_path' in request.resource.data)
          || request.resource.data.media_path == null
        )
        && (
          !('thumb_url' in request.resource.data)
          || request.resource.data.thumb_url == null
        )
        && (
          !('deleted_at' in request.resource.data)
          || request.resource.data.deleted_at == request.time
        );
    }

    function canUpdateMessage(chatId) {
      return isMemberOfChat(chatId)
        && messageImmutableFieldsUnchanged()
        && (
          isAuthorizedSignerUpdate()
          || isSoftDeleteUpdate()
          || isOwnMessageNonSenderEdit()
        );
    }

    function peerUserChatAllowedKeys() {
      return [
        'type',
        'title',
        'updated_at',
        'peer_uid',
        'role_id',
        'branch_id',
        'company_id',
        'support_user_uid',
        'support_group_title',
        'pinned',
        'muted',
        'archived',
        'has_messages'
      ];
    }

    function peerUserChatKeysOk() {
      return request.resource.data.keys()
        .hasOnly(peerUserChatAllowedKeys());
    }

    function peerUserChatUpdateKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(peerUserChatAllowedKeys());
    }

    function canPeerWriteUserChat(chatId) {
      return isMemberOfChat(chatId)
        && (
          (resource == null && peerUserChatKeysOk())
          || (resource != null && peerUserChatUpdateKeysOk())
        );
    }

    function isTodoStatusOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'assigned_members',
        'followed_up_by',
        'is_completed',
        'is_important',
        'is_my_day',
        'sort_order',
        'updated_at'
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;

      match /fcm_tokens/{token} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /todos/{todoId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() &&
            (request.auth.uid == userId || isTodoStatusOnlyUpdate());

        match /comments/{commentId} {
          allow read, write: if isSignedIn();
        }
      }

      match /tickets/{ticketId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == userId;
      }

      match /todoLists/{listId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /signature_documents/{docId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource != null &&
           resource.data.recipient_uid == request.auth.uid)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && (
          request.auth.uid == userId ||
          (
            resource.data.recipient_uid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'status',
                'signed_pdf_url',
                'file_url',
                'signed_at',
                'signed_by',
                'recipient_uid',
                'recipient_name',
                'current_signer_index',
                'updated_at'
              ])
          )
        );
      }

      match /notes/{noteId} {
        allow read: if isSignedIn() && (
          request.auth.uid == userId ||
          (resource.data.sharedWithUids != null &&
           request.auth.uid in resource.data.sharedWithUids)
        );
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId;
      }

      match /shared_note_refs/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow create: if canCreateChat(chatId);
      allow read: if canReadChat();
      allow update: if canUpdateChat(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn() && isMemberOfChat(chatId);
        allow create: if isSignedIn()
          && isMemberOfChat(chatId)
          && isMessageCreateValid();
        allow update: if isSignedIn() && canUpdateMessage(chatId);
        allow delete: if false;
      }

      match /members/{memberId} {
        allow read: if isSignedIn() && isMemberOfChat(chatId);
        allow create, update: if canWriteMemberDoc(chatId, memberId);
        allow delete: if canDeleteMemberDoc(chatId, memberId);
      }
    }

    // Inbox index — owner full access; peers may sync allowlisted fields only.
    match /userChats/{userId}/chats/{chatId} {
      allow read: if isSignedIn() && uid() == userId;
      allow create: if isSignedIn() && (
        uid() == userId
        || canPeerWriteUserChat(chatId)
      );
      allow update: if isSignedIn() && (
        uid() == userId
        || canPeerWriteUserChat(chatId)
      );
      allow delete: if isSignedIn() && uid() == userId;
    }

    match /userChats/{userId}/starred_messages/{messageId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // Legacy Firestore presence (unused by chat — RTDB is authoritative).
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /{path=**}/todos/{todoId} {
      allow read: if isSignedIn();
    }

    match /assignment_push_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /ticket_creators/{taskId} {
      allow create, update: if isSignedIn();
      allow read: if isSignedIn();
      allow delete: if false;
    }
  }
}
