<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.fluttercommunity.workmanager.BackgroundFetch</string>
		<string>dev.fluttercommunity.workmanager.BackgroundProcessingTask</string>
		<string>dev.fluttercommunity.workmanager.BackgroundPeriodicTask</string>
		<string>dev.fluttercommunity.workmanager.OneOffTask</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Elrace Company</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>el_race</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uaepass</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>elrace</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>sms</string>
		<string>tel</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used to scan QR codes, take profile and report photos, scan documents, and for face recognition during attendance check-in.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used for voice messages and audio recording in the chat feature.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID is used to securely check you into your workplace without typing a password.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We use your location to verify your attendance and ensure you are at the correct work location when checking in.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Your location is used to confirm your attendance by recording your current position, even if the app is running in the background.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to confirm your attendance by recording the location where you check in.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Access to your photo library allows you to choose a profile picture for your account.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition may be used by voice assistant features that support timesheet face attendance prompts and related workplace voice feedback.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
